  },
  "dependencies": {
    "@angular/core": "^22.1.7",
    "playwright": "^1.55.0"
  },
  "devDependencies": { "typescript": "^5.9.0" },
  "peerDependencies": { "@angular/core": ">=19.0.0" }
}
