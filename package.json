{
  "name": "@orbyta/visual-testing",
  "version": "0.1.0",
  "description": "Visual regression testing for Angular applications powered by Playwright.",
  "type": "module",
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
