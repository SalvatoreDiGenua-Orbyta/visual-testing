{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "visual-testing-angular-fixture": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "vt",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "outputPath": "dist"
          },
          "configurations": {
            "integration": {
              "browser": "src/integration-main.ts"
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {},
          "configurations": {
            "integration": {
              "buildTarget": "visual-testing-angular-fixture:build:integration"
            }
          }
        }
      }
    }
  },
  "cli": {
    "packageManager": "npm"
  }
}
